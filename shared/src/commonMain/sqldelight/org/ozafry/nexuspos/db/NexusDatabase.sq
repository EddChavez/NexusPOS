CREATE TABLE Category (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    color_hex TEXT,
    icon TEXT
);

CREATE TABLE Product (
    id TEXT NOT NULL PRIMARY KEY,
    sku TEXT NOT NULL UNIQUE,
    barcode TEXT,
    name TEXT NOT NULL,
    category_id TEXT,
    price REAL NOT NULL,
    cost_price REAL NOT NULL DEFAULT 0.0,
    tax_rate REAL NOT NULL DEFAULT 0.16,
    stock_quantity REAL NOT NULL DEFAULT 0.0,
    unit TEXT NOT NULL DEFAULT 'PZA',
    is_active INTEGER NOT NULL DEFAULT 1,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (category_id) REFERENCES Category(id)
);

CREATE INDEX product_barcode_idx ON Product(barcode);
CREATE INDEX product_sku_idx ON Product(sku);

CREATE TABLE CashRegister (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    branch_name TEXT NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE CashShift (
    id TEXT NOT NULL PRIMARY KEY,
    register_id TEXT NOT NULL,
    cashier_name TEXT NOT NULL,
    opened_at INTEGER NOT NULL,
    closed_at INTEGER,
    initial_cash REAL NOT NULL DEFAULT 0.0,
    cash_sales REAL NOT NULL DEFAULT 0.0,
    card_sales REAL NOT NULL DEFAULT 0.0,
    transfer_sales REAL NOT NULL DEFAULT 0.0,
    cash_in REAL NOT NULL DEFAULT 0.0,
    cash_out REAL NOT NULL DEFAULT 0.0,
    expected_cash REAL NOT NULL DEFAULT 0.0,
    actual_cash REAL,
    notes TEXT,
    status TEXT NOT NULL DEFAULT 'OPEN'
);

CREATE TABLE Sale (
    id TEXT NOT NULL PRIMARY KEY,
    shift_id TEXT NOT NULL,
    register_id TEXT NOT NULL,
    cashier_name TEXT NOT NULL,
    customer_name TEXT,
    subtotal REAL NOT NULL,
    tax_total REAL NOT NULL,
    discount_total REAL NOT NULL DEFAULT 0.0,
    total REAL NOT NULL,
    payment_method TEXT NOT NULL,
    amount_paid REAL NOT NULL,
    change_given REAL NOT NULL DEFAULT 0.0,
    status TEXT NOT NULL DEFAULT 'COMPLETED',
    created_at INTEGER NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (shift_id) REFERENCES CashShift(id)
);

CREATE TABLE SaleItem (
    id TEXT NOT NULL PRIMARY KEY,
    sale_id TEXT NOT NULL,
    product_id TEXT NOT NULL,
    product_name TEXT NOT NULL,
    unit_price REAL NOT NULL,
    quantity REAL NOT NULL,
    unit TEXT NOT NULL DEFAULT 'PZA',
    subtotal REAL NOT NULL,
    tax_rate REAL NOT NULL,
    tax_amount REAL NOT NULL,
    discount_amount REAL NOT NULL DEFAULT 0.0,
    total REAL NOT NULL,
    FOREIGN KEY (sale_id) REFERENCES Sale(id) ON DELETE CASCADE
);

CREATE INDEX sale_item_sale_id_idx ON SaleItem(sale_id);

CREATE TABLE SyncEvent (
    id TEXT NOT NULL PRIMARY KEY,
    aggregate_type TEXT NOT NULL,
    aggregate_id TEXT NOT NULL,
    action TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING',
    retry_count INTEGER NOT NULL DEFAULT 0,
    error_message TEXT,
    created_at INTEGER NOT NULL,
    synced_at INTEGER
);

CREATE INDEX sync_event_status_idx ON SyncEvent(status, created_at);

-- Queries for Category
selectAllCategories:
SELECT * FROM Category ORDER BY name ASC;

insertCategory:
INSERT OR REPLACE INTO Category(id, name, color_hex, icon)
VALUES (?, ?, ?, ?);

-- Queries for Product
selectAllProducts:
SELECT * FROM Product WHERE is_active = 1 ORDER BY name ASC;

selectProductById:
SELECT * FROM Product WHERE id = ?;

selectProductByBarcodeOrSku:
SELECT * FROM Product WHERE barcode = ? OR sku = ? LIMIT 1;

searchProducts:
SELECT * FROM Product
WHERE is_active = 1 AND (name LIKE '%' || :query || '%' OR sku LIKE '%' || :query || '%' OR barcode LIKE '%' || :query || '%')
ORDER BY name ASC;

upsertProduct:
INSERT OR REPLACE INTO Product(id, sku, barcode, name, category_id, price, cost_price, tax_rate, stock_quantity, unit, is_active, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

decreaseProductStock:
UPDATE Product SET stock_quantity = stock_quantity - :qty, updated_at = :updatedAt WHERE id = :productId;

-- Queries for CashShift
selectCurrentOpenShift:
SELECT * FROM CashShift WHERE status = 'OPEN' ORDER BY opened_at DESC LIMIT 1;

selectShiftById:
SELECT * FROM CashShift WHERE id = ?;

insertShift:
INSERT INTO CashShift(id, register_id, cashier_name, opened_at, initial_cash, expected_cash, status)
VALUES (?, ?, ?, ?, ?, ?, 'OPEN');

closeShift:
UPDATE CashShift
SET closed_at = :closedAt, actual_cash = :actualCash, notes = :notes, status = 'CLOSED'
WHERE id = :id;

updateShiftSalesTotals:
UPDATE CashShift
SET cash_sales = cash_sales + :cashAmount,
    card_sales = card_sales + :cardAmount,
    transfer_sales = transfer_sales + :transferAmount,
    expected_cash = initial_cash + cash_sales + :cashAmount + cash_in - cash_out
WHERE id = :shiftId;

-- Queries for Sale
selectAllSales:
SELECT * FROM Sale ORDER BY created_at DESC;

selectSalesByShift:
SELECT * FROM Sale WHERE shift_id = ? ORDER BY created_at DESC;

selectSaleById:
SELECT * FROM Sale WHERE id = ?;

selectSaleItemsBySaleId:
SELECT * FROM SaleItem WHERE sale_id = ?;

insertSale:
INSERT INTO Sale(
    id, shift_id, register_id, cashier_name, customer_name,
    subtotal, tax_total, discount_total, total,
    payment_method, amount_paid, change_given, status, created_at, synced
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSaleItem:
INSERT INTO SaleItem(
    id, sale_id, product_id, product_name, unit_price, quantity, unit, subtotal, tax_rate, tax_amount, discount_amount, total
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markSaleSynced:
UPDATE Sale SET synced = 1 WHERE id = ?;

selectUnsyncedSales:
SELECT * FROM Sale WHERE synced = 0 ORDER BY created_at ASC;

-- Queries for SyncEvent (Outbox Pattern)
insertSyncEvent:
INSERT INTO SyncEvent(id, aggregate_type, aggregate_id, action, payload_json, status, retry_count, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectPendingSyncEvents:
SELECT * FROM SyncEvent WHERE status = 'PENDING' ORDER BY created_at ASC LIMIT :limit;

markSyncEventInFlight:
UPDATE SyncEvent SET status = 'IN_FLIGHT' WHERE id = ?;

markSyncEventSuccess:
UPDATE SyncEvent SET status = 'SYNCED', synced_at = :syncedAt, error_message = NULL WHERE id = ?;

markSyncEventFailed:
UPDATE SyncEvent SET status = 'PENDING', retry_count = retry_count + 1, error_message = :errorMessage WHERE id = ?;

deleteOldSyncedEvents:
DELETE FROM SyncEvent WHERE status = 'SYNCED' AND synced_at < :olderThanTimestamp;
